@startuml Architecture Diagram

skinparam monochrome true
skinparam packageStyle rectangle

package "External Client Systems" {
  [Client Systems]
}

package "API Gateway" {
  [API Gateway]
}

package "ComplianceValidatorService" {
  [API Controller]
  [Interceptor Layer]
  [Rule Processor]
  [Drools Engine]
  [Async Processor]
  
  [API Controller] --> [Interceptor Layer]
  [Interceptor Layer] --> [Rule Processor]
  [Rule Processor] --> [Drools Engine]
  [Rule Processor] --> [Async Processor]
}

package "Future Expansion" #..# {
  !define RECTANGLE class
  skinparam classBorderColor blue
  skinparam classBackgroundColor none
  skinparam classBorderThickness 1
  skinparam classAttributeFontColor blue

  [MongoDB]
  [Redis]
  [Message Queue]
  [Monitoring System]
}

[Client Systems] --> [API Gateway] : HTTP
[API Gateway] --> [API Controller] : HTTP
[ComplianceValidatorService] --> [MongoDB] : Query
[ComplianceValidatorService] --> [Redis] : Cache
[ComplianceValidatorService] --> [Message Queue] : Publish
[ComplianceValidatorService] --> [Monitoring System] : Logs/Metrics
[Message Queue] --> [MongoDB] : Results

note right of ComplianceValidatorService
  Tech: Spring Boot, Drools
  Performance: <500ms latency
end note

@enduml